# Token dell'app Slack (vedi README, "Setup Slack")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ID del canale dove il backoffice lavora i ticket (tasto destro sul canale → Copia link: e' l'ultimo pezzo, C...)
BACKOFFICE_CHANNEL=C0000000000

# Facoltativo: ID Slack con cui riempire il team del backoffice al primo avvio (separati da virgola).
# Dopo, il team si gestisce dalla pagina Team della dashboard.
BACKOFFICE_USERS=

# Facoltativo: categorie del modulo, separate da virgola
# CATEGORIES=Contratti e mandati,Pubblicazione annunci,Documenti e visure,Amministrazione e provvigioni,IT e accessi,Altro

# Dashboard web in sola lettura. Senza password resta spenta.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=3000
# Facoltativo: per il link "Apri il thread su Slack" dalla dashboard
SLACK_WORKSPACE_URL=https://gromia.slack.com

# Dove salvare il database (SQLite)
DB_PATH=data/tickets.db
